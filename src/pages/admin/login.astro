---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getViewerContext } from '../../server/auth';

const viewer = getViewerContext(Astro.cookies, Astro.url);
if (viewer.isAuthenticated) {
  return Astro.redirect('/admin');
}
---

<BaseLayout title="Acceso Administrador y Editor">
  <div class="mx-auto max-w-md py-10">
    <div class="rounded-3xl border border-slate-800 bg-surface-900/90 p-7 shadow-2xl sm:p-8">
      <div class="flex items-center justify-between">
        <span class="rounded-md border border-amber-500/40 bg-amber-500/10 px-2.5 py-1 font-mono text-[11px] font-semibold text-amber-300">
          STUDIO // ADMIN AUTH
        </span>
        <a href="/" class="font-mono text-xs text-slate-400 hover:text-cyan-300">← Vista Visitante</a>
      </div>

      <h1 class="mt-4 text-2xl font-extrabold text-white">Vista Administrador & Editor</h1>
      <p class="mt-2 text-xs leading-relaxed text-slate-400">
        Inicia sesión para habilitar los espacios de carga de archivos, subir evidencias (diagramas, capturas, PDFs, videos), editar entradas y alternar entre la <strong>Vista Editor</strong> y la <strong>Vista Solo Visualización</strong>.
      </p>

      <form id="admin-login-form" class="mt-6 space-y-4">
        <div>
          <label for="password" class="block font-mono text-xs text-slate-300">Clave de Administrador</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autofocus
            placeholder="Ingresa tu contraseña..."
            class="mt-1.5 w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-2.5 font-mono text-sm text-white focus:border-cyan-400 focus:outline-none"
          />
        </div>

        <p id="login-error" class="hidden rounded-lg border border-rose-500/40 bg-rose-500/10 px-3 py-2 font-mono text-xs text-rose-300"></p>

        <button
          type="submit"
          class="w-full rounded-xl bg-cyan-500 px-4 py-2.5 font-mono text-xs font-bold uppercase tracking-wider text-slate-950 transition hover:bg-cyan-400"
        >
          Desbloquear Modo Administrador →
        </button>
      </form>

      <div class="mt-6 rounded-xl border border-slate-800 bg-slate-950/80 p-3.5 font-mono text-[11px] text-slate-400">
        <p class="text-slate-300">Configuración local:</p>
        <p class="mt-1">
          Clave por defecto: <code class="rounded bg-slate-900 px-1.5 py-0.5 text-cyan-300">umad-ebl-2026</code> (personalizable en <code class="text-slate-300">.env</code> con <code class="text-slate-300">ADMIN_PASSWORD</code>).
        </p>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
    const errEl = document.getElementById('login-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl?.classList.add('hidden');
      const fd = new FormData(form);
      const password = fd.get('password');

      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });

      const data = await res.json();
      if (res.ok && data.ok) {
        window.location.href = '/admin';
      } else {
        if (errEl) {
          errEl.textContent = data.error || 'Clave inválida';
          errEl.classList.remove('hidden');
        }
      }
    });
  </script>
</BaseLayout>
