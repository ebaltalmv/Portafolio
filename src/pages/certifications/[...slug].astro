---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionDetailView from '../../components/bento/SectionDetailView.astro';
import { getEntry } from '../../server/db';
import { getViewerContext } from '../../server/auth';

const slug = Astro.params.slug || '';
const viewer = getViewerContext(Astro.cookies, Astro.url);
const entry = await getEntry('certifications', slug, viewer.isEditorView);

if (!entry) {
  return Astro.redirect('/certifications');
}
---

<BaseLayout title={entry.title} description={entry.summary} currentSection="certifications" currentSlug={entry.slug}>
  <SectionDetailView entry={entry} isEditorView={viewer.isEditorView} />
</BaseLayout>
