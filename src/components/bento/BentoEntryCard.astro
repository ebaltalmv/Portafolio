---
import type { PortfolioEntry } from '../../server/schemas';
import TechBadge from '../ui/TechBadge.astro';

interface Props {
  entry: PortfolioEntry;
  isEditorView: boolean;
}

const { entry, isEditorView } = Astro.props;

const coverImage =
  entry.evidences.find((ev) => ev.isCover && ev.mediaKind === 'image') ||
  entry.evidences.find((ev) => ev.mediaKind === 'image');

const uploadedCount = entry.evidences.length;
const totalSlots = entry.evidenceSlots.length;
const pendingSlots = entry.evidenceSlots.filter(
  (slot) => !entry.evidences.some((ev) => ev.slotId === slot.slotId)
).length;

const spanClass =
  entry.bentoSpan === 'col-span-3'
    ? 'lg:col-span-3 md:col-span-2'
    : entry.bentoSpan === 'col-span-2'
      ? 'lg:col-span-2 md:col-span-2'
      : 'col-span-1';

const metaBadge =
  entry.details.course ||
  entry.details.issuer ||
  entry.details.receivingInstitution ||
  entry.details.eventName ||
  entry.details.edition ||
  entry.details.projectType ||
  entry.details.articleCategory ||
  entry.publishDate;

const subMeta =
  entry.details.semester ||
  entry.details.issueDate ||
  entry.details.period ||
  entry.details.eventDate ||
  entry.publishDate;

const primaryMetric = entry.metrics[0];
const detailHref = `/${entry.section}/${entry.slug}`;
---

<article
  class:list={[
    'group relative flex flex-col justify-between overflow-hidden rounded-2xl border bg-surface-900/80 transition duration-200',
    entry.draft
      ? 'border-amber-500/40 bg-amber-950/10'
      : 'border-slate-800/90 hover:border-cyan-500/40 hover:bg-surface-850/90',
    spanClass,
  ]}
>
  {coverImage && (
    <a href={detailHref} class="relative block h-44 w-full overflow-hidden border-b border-slate-800/80 bg-slate-950">
      <img
        src={coverImage.url}
        alt={coverImage.alt}
        loading="lazy"
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-surface-900 via-transparent to-transparent"></div>
    </a>
  )}

  <div class="flex flex-1 flex-col justify-between p-5 sm:p-6">
    <div>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <span class="line-clamp-1 font-mono text-[11px] text-cyan-400">{metaBadge}</span>
        <div class="flex items-center gap-1.5">
          {entry.draft && (
            <span class="rounded border border-amber-400/50 bg-amber-500/15 px-2 py-0.5 font-mono text-[10px] font-semibold text-amber-300">
              BORRADOR
            </span>
          )}
          <span class="rounded border border-slate-800 bg-slate-950/70 px-2 py-0.5 font-mono text-[10px] text-slate-400">
            {subMeta}
          </span>
        </div>
      </div>

      <a href={detailHref} class="mt-2.5 block">
        <h3 class="text-lg font-bold leading-snug text-white transition group-hover:text-cyan-300">
          {entry.title}
        </h3>
      </a>

      {entry.subtitle && (
        <p class="mt-1 line-clamp-1 font-mono text-xs text-slate-400">{entry.subtitle}</p>
      )}

      <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-slate-300">{entry.summary}</p>
    </div>

    <div class="mt-5 space-y-4">
      {primaryMetric && (
        <div class="flex items-center justify-between rounded-lg border border-slate-800/90 bg-surface-950/70 px-3 py-2">
          <span class="font-mono text-[11px] text-slate-400">{primaryMetric.label}</span>
          <span class="font-mono text-xs font-bold text-emerald-400">{primaryMetric.value}</span>
        </div>
      )}

      {entry.techStack.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {entry.techStack.slice(0, 5).map((tech) => (
            <TechBadge item={tech} compact={true} />
          ))}
          {entry.techStack.length > 5 && (
            <span class="rounded-md border border-slate-800 bg-slate-900 px-2 py-0.5 font-mono text-[11px] text-slate-400">
              +{entry.techStack.length - 5}
            </span>
          )}
        </div>
      )}

      <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-800/80 pt-3.5">
        <a
          href={detailHref}
          class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-cyan-300 transition hover:text-cyan-200"
        >
          <span>Documentación técnica</span>
          <span class="transition group-hover:translate-x-0.5">→</span>
        </a>

        {isEditorView ? (
          <div class="flex items-center gap-2">
            <a
              href={`${detailHref}#evidencias`}
              class:list={[
                'rounded-md border px-2 py-1 font-mono text-[11px] transition',
                pendingSlots > 0
                  ? 'border-amber-500/40 bg-amber-500/10 text-amber-300 hover:bg-amber-500/20'
                  : 'border-emerald-500/40 bg-emerald-500/10 text-emerald-300 hover:bg-emerald-500/20',
              ]}
              title="Ir directo a subir o administrar archivos de evidencia"
            >
              ↑ Evidencias ({uploadedCount}/{totalSlots || uploadedCount})
            </a>
            <a
              href={`/admin/editor/${entry.section}/${entry.slug}`}
              class="rounded-md border border-slate-700 bg-slate-800 px-2 py-1 font-mono text-[11px] text-slate-200 hover:border-cyan-500/40 hover:text-cyan-300"
            >
              Editar
            </a>
          </div>
        ) : (
          uploadedCount > 0 && (
            <span class="font-mono text-[11px] text-emerald-400">
              {uploadedCount} {uploadedCount === 1 ? 'evidencia adjunta' : 'evidencias adjuntas'}
            </span>
          )
        )}
      </div>
    </div>
  </div>
</article>
