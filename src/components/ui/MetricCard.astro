---
import type { MetricItem } from '../../server/schemas';

interface Props {
  metric: MetricItem;
}

const { metric } = Astro.props;
---

<div class="rounded-xl border border-slate-800/90 bg-surface-900/80 p-4 transition hover:border-cyan-500/30">
  <p class="font-mono text-[11px] uppercase tracking-wider text-slate-400">{metric.label}</p>
  <div class="mt-1.5 flex items-baseline gap-1.5">
    <span class="font-mono text-2xl font-bold tracking-tight text-cyan-300">{metric.value}</span>
    {metric.unit && <span class="font-mono text-xs text-slate-400">{metric.unit}</span>}
  </div>
  {metric.description && <p class="mt-2 text-xs leading-relaxed text-slate-400">{metric.description}</p>}
</div>
