---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { requireAdminAuth, getViewerContext } from '../../server/auth';
import { getProfile, getAllEntries, formatBytes } from '../../server/db';
import { SECTION_KEYS, SECTION_META } from '../../server/schemas';

if (!requireAdminAuth(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

const viewer = getViewerContext(Astro.cookies, Astro.url);
const profile = await getProfile();
const entries = await getAllEntries(true);

const totalEvidences = entries.reduce((acc, e) => acc + e.evidences.length, 0);
const totalSlots = entries.reduce((acc, e) => acc + e.evidenceSlots.length, 0);
const pendingSlots = entries.reduce(
  (acc, e) =>
    acc + e.evidenceSlots.filter((s) => !e.evidences.some((ev) => ev.slotId === s.slotId)).length,
  0
);
const draftsCount = entries.filter((e) => e.draft).length;
---

<BaseLayout title="Studio Administrador & Editor de Evidencias">
  <div class="space-y-10">
    {/* 1. Cabecera del Centro de Control */}
    <section class="rounded-3xl border border-amber-500/30 bg-surface-900/90 p-6 sm:p-8">
      <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-amber-400/40 bg-amber-500/15 px-3 py-1 font-mono text-xs font-semibold text-amber-300">
            <span>⚙ PANEL CENTRAL // ADMINISTRADOR & EDITOR WEB</span>
          </span>
          <h1 class="mt-3 text-3xl font-extrabold text-white">Studio de Gestión del Portafolio</h1>
          <p class="mt-1.5 max-w-2xl text-sm text-slate-300">
            Administra tus 8 secciones, sube tus propios archivos de evidencia en los espacios reservados y alterna en cualquier instante entre la <strong>Vista Administrador/Editor</strong> y la <strong>Vista Solo Visualización</strong>.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href="/admin/new"
            class="rounded-xl bg-emerald-500 px-4 py-2.5 font-mono text-xs font-bold text-slate-950 transition hover:bg-emerald-400"
          >
            + Nueva Entrada / Proyecto
          </a>
          <a
            href="/api/backup"
            class="rounded-xl border border-slate-700 bg-slate-800 px-4 py-2.5 font-mono text-xs text-slate-200 transition hover:border-cyan-400"
          >
            ↓ Respaldar Base JSON
          </a>
        </div>
      </div>

      {/* Selector de Dos Vistas */}
      <div class="mt-6 grid grid-cols-1 gap-4 border-t border-slate-800 pt-6 md:grid-cols-2">
        <div
          class:list={[
            'rounded-2xl border p-4',
            viewer.isEditorView
              ? 'border-amber-400/60 bg-amber-500/10'
              : 'border-slate-800 bg-surface-950/70',
          ]}
        >
          <div class="flex items-center justify-between">
            <h2 class="font-mono text-xs font-bold uppercase text-amber-300">
              1. Vista Administrador y Editor
            </h2>
            {viewer.isEditorView && (
              <span class="rounded bg-amber-400 px-2 py-0.5 font-mono text-[10px] font-bold text-slate-950">
                ACTIVA AHORA
              </span>
            )}
          </div>
          <p class="mt-1.5 text-xs text-slate-300">
            Muestra en todas las páginas los espacios para subir tus archivos (diagramas, capturas, PDFs, videos), botones de edición inline y borradores ocultos.
          </p>
          {!viewer.isEditorView && (
            <button
              type="button"
              data-admin-mode="editor"
              class="mt-3 rounded-lg bg-amber-400 px-3.5 py-1.5 font-mono text-xs font-bold text-slate-950"
            >
              Activar Vista Editor ✎
            </button>
          )}
        </div>

        <div
          class:list={[
            'rounded-2xl border p-4',
            !viewer.isEditorView
              ? 'border-emerald-400/60 bg-emerald-500/10'
              : 'border-slate-800 bg-surface-950/70',
          ]}
        >
          <div class="flex items-center justify-between">
            <h2 class="font-mono text-xs font-bold uppercase text-emerald-300">
              2. Vista Solo Visualización (Visitante)
            </h2>
            {!viewer.isEditorView && (
              <span class="rounded bg-emerald-400 px-2 py-0.5 font-mono text-[10px] font-bold text-slate-950">
                ACTIVA AHORA
              </span>
            )}
          </div>
          <p class="mt-1.5 text-xs text-slate-300">
            Renderiza únicamente tus proyectos publicados y las evidencias ya subidas (Lightbox, visor PDF y reproductor de video) ocultando formularios de carga.
          </p>
          <button
            type="button"
            data-admin-mode="visitor"
            class="mt-3 rounded-lg border border-emerald-500/40 bg-emerald-500/15 px-3.5 py-1.5 font-mono text-xs font-semibold text-emerald-300 hover:bg-emerald-500/25"
          >
            Ir a Previsualizar Vista Visitante 👁 →
          </button>
        </div>
      </div>

      {/* KPIs de estado */}
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-800 bg-surface-950 p-4">
          <span class="font-mono text-[11px] text-slate-400">Entradas Totales</span>
          <p class="mt-1 font-mono text-2xl font-bold text-white">{entries.length}</p>
          <p class="font-mono text-[11px] text-slate-500">{draftsCount} borradores</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-surface-950 p-4">
          <span class="font-mono text-[11px] text-slate-400">Evidencias Subidas</span>
          <p class="mt-1 font-mono text-2xl font-bold text-emerald-400">{totalEvidences}</p>
          <p class="font-mono text-[11px] text-slate-500">Renderizadas en web</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-surface-950 p-4">
          <span class="font-mono text-[11px] text-slate-400">Espacios Pendientes</span>
          <p class="mt-1 font-mono text-2xl font-bold text-amber-300">{pendingSlots}</p>
          <p class="font-mono text-[11px] text-slate-500">De {totalSlots} slots sugeridos</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-surface-950 p-4">
          <span class="font-mono text-[11px] text-slate-400">CV Oficial PDF</span>
          <p class="mt-1 font-mono text-lg font-bold text-cyan-300">
            {profile.cvDocument ? '✓ Cargado' : 'Pendiente'}
          </p>
          <p class="font-mono text-[11px] text-slate-500">Botón Hero Home</p>
        </div>
      </div>
    </section>

    {/* 2. Gestor de CV Descargable & Perfil Profesional */}
    <section id="cv-manager" class="grid grid-cols-1 gap-6 lg:grid-cols-12">
      <div class="space-y-4 rounded-3xl border border-slate-800 bg-surface-900/85 p-6 lg:col-span-5">
        <span class="font-mono text-xs font-bold uppercase text-cyan-400">ARCHIVO DE CV OFICIAL (HERO HOME)</span>
        <h2 class="text-xl font-bold text-white">Currículum Vitae Descargable</h2>
        <p class="text-xs text-slate-300">
          Sube aquí tu archivo <code class="text-cyan-300">CV_Emmanuel-Baltazar-Lopez.pdf</code> para habilitar el botón de descarga/lectura inmediata en la portada principal.
        </p>

        {profile.cvDocument ? (
          <div class="rounded-2xl border border-emerald-500/40 bg-emerald-950/20 p-4">
            <p class="font-mono text-xs font-semibold text-emerald-300">✓ {profile.cvDocument.fileName}</p>
            <p class="mt-1 font-mono text-[11px] text-slate-400">
              Tamaño: {formatBytes(profile.cvDocument.fileSize)}
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <a
                href={profile.cvDocument.url}
                target="_blank"
                class="rounded-lg bg-emerald-500 px-3 py-1.5 font-mono text-xs font-bold text-slate-950"
              >
                Ver PDF actual ↗
              </a>
              <button
                type="button"
                id="btn-delete-cv"
                class="rounded-lg border border-rose-500/40 bg-rose-500/10 px-3 py-1.5 font-mono text-xs text-rose-300"
              >
                Quitar CV
              </button>
            </div>
          </div>
        ) : (
          <div class="rounded-2xl border border-dashed border-slate-700 bg-surface-950 p-4 text-xs text-slate-400">
            Aún no se ha subido el PDF del CV. Selecciónalo abajo para activarlo.
          </div>
        )}

        <form id="cv-upload-form" class="space-y-3 pt-1">
          <input
            type="file"
            name="file"
            accept=".pdf,.doc,.docx"
            required
            class="block w-full cursor-pointer rounded-xl border border-slate-700 bg-slate-950 text-xs text-slate-300 file:mr-3 file:rounded-lg file:border-0 file:bg-cyan-500/20 file:px-3 file:py-2 file:font-mono file:text-xs file:font-semibold file:text-cyan-300"
          />
          <button
            type="submit"
            class="w-full rounded-xl bg-cyan-500 px-4 py-2 font-mono text-xs font-bold text-slate-950 transition hover:bg-cyan-400"
          >
            ↑ Subir / Actualizar CV Oficial
          </button>
        </form>
      </div>

      <form id="profile-quick-form" class="space-y-4 rounded-3xl border border-slate-800 bg-surface-900/85 p-6 lg:col-span-7">
        <div class="flex items-center justify-between">
          <div>
            <span class="font-mono text-xs font-bold uppercase text-emerald-400">DATOS DE CABECERA</span>
            <h2 class="text-xl font-bold text-white">Perfil Profesional Principal</h2>
          </div>
          <button
            type="submit"
            class="rounded-xl bg-emerald-500 px-4 py-2 font-mono text-xs font-bold text-slate-950 hover:bg-emerald-400"
          >
            Guardar Perfil
          </button>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label class="block font-mono text-[11px] text-slate-400">Nombre Completo</label>
            <input type="text" name="fullName" value={profile.fullName} class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-950 px-3 py-1.5 text-xs text-white" />
          </div>
          <div>
            <label class="block font-mono text-[11px] text-slate-400">Semestre Actual</label>
            <input type="text" name="currentSemester" value={profile.currentSemester} class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-950 px-3 py-1.5 text-xs text-white" />
          </div>
          <div class="sm:col-span-2">
            <label class="block font-mono text-[11px] text-slate-400">Titular / Headline Técnico</label>
            <input type="text" name="headline" value={profile.headline} class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-950 px-3 py-1.5 text-xs text-white" />
          </div>
          <div>
            <label class="block font-mono text-[11px] text-slate-400">GitHub URL</label>
            <input type="url" name="githubUrl" value={profile.githubUrl} class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-950 px-3 py-1.5 font-mono text-xs text-white" />
          </div>
          <div>
            <label class="block font-mono text-[11px] text-slate-400">LinkedIn URL</label>
            <input type="url" name="linkedinUrl" value={profile.linkedinUrl} class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-950 px-3 py-1.5 font-mono text-xs text-white" />
          </div>
          <div class="sm:col-span-2">
            <label class="block font-mono text-[11px] text-slate-400">Resumen Profesional (Bio)</label>
            <textarea name="bio" rows="3" class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-950 px-3 py-2 text-xs text-white">{profile.bio}</textarea>
          </div>
        </div>
      </form>
    </section>

    {/* 3. Catálogo Maestro por Sección con Accesos Directos a Carga de Evidencias */}
    <section class="space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <span class="font-mono text-xs font-bold uppercase text-cyan-400">
            CATÁLOGO DE LAS 8 SECCIONES DEL PORTAFOLIO
          </span>
          <h2 class="mt-1 text-2xl font-bold text-white">Entradas y Espacios de Archivos</h2>
        </div>

        <div class="flex flex-wrap gap-1.5">
          <button
            type="button"
            data-sec-filter="all"
            class="ebl-sec-tab rounded-lg bg-cyan-500 px-3 py-1.5 font-mono text-xs font-bold text-slate-950"
          >
            Todas ({entries.length})
          </button>
          {SECTION_KEYS.map((sec) => {
            const count = entries.filter((e) => e.section === sec).length;
            return (
              <button
                type="button"
                data-sec-filter={sec}
                class="ebl-sec-tab rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 font-mono text-xs text-slate-300 hover:border-cyan-500/40"
              >
                {SECTION_META[sec].shortTitle} ({count})
              </button>
            );
          })}
        </div>
      </div>

      <div class="space-y-3">
        {entries.map((entry) => {
          const slotsDone = entry.evidenceSlots.filter((s) =>
            entry.evidences.some((ev) => ev.slotId === s.slotId)
          ).length;

          return (
            <div
              data-entry-row={entry.section}
              class="flex flex-col justify-between gap-4 rounded-2xl border border-slate-800 bg-surface-900/85 p-4 transition hover:border-slate-700 md:flex-row md:items-center"
            >
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded border border-cyan-500/30 bg-cyan-500/10 px-2 py-0.5 font-mono text-[10px] text-cyan-300">
                    {SECTION_META[entry.section].shortTitle}
                  </span>
                  {entry.draft && (
                    <span class="rounded border border-amber-500/40 bg-amber-500/15 px-2 py-0.5 font-mono text-[10px] font-bold text-amber-300">
                      BORRADOR
                    </span>
                  )}
                  <span class="font-mono text-[11px] text-slate-400">/{entry.section}/{entry.slug}</span>
                </div>
                <h3 class="text-base font-bold text-white">{entry.title}</h3>
                <p class="font-mono text-xs text-slate-400">
                  Archivos subidos: <strong class="text-emerald-400">{entry.evidences.length}</strong> · Espacios guía completados:{' '}
                  <strong class="text-amber-300">{slotsDone}/{entry.evidenceSlots.length}</strong>
                </p>
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <a
                  href={`/${entry.section}/${entry.slug}#evidencias`}
                  class="rounded-xl border border-amber-500/40 bg-amber-500/15 px-3.5 py-2 font-mono text-xs font-semibold text-amber-300 hover:bg-amber-500/25"
                >
                  ↑ Subir Archivos
                </a>
                <a
                  href={`/admin/editor/${entry.section}/${entry.slug}`}
                  class="rounded-xl border border-cyan-500/40 bg-cyan-500/10 px-3.5 py-2 font-mono text-xs font-semibold text-cyan-300 hover:bg-cyan-500/20"
                >
                  ✎ Editar Datos
                </a>
                <a
                  href={`/${entry.section}/${entry.slug}`}
                  class="rounded-xl border border-slate-700 bg-slate-800 px-3 py-2 font-mono text-xs text-slate-200 hover:border-slate-500"
                >
                  👁 Ver
                </a>
                <button
                  type="button"
                  class="ebl-delete-entry rounded-xl border border-rose-500/30 bg-rose-500/10 px-3 py-2 font-mono text-xs text-rose-300 hover:bg-rose-500/20"
                  data-section={entry.section}
                  data-slug={entry.slug}
                  data-title={entry.title}
                >
                  🗑
                </button>
              </div>
            </div>
          );
        })}
      </div>

      {/* Accesos rápidos para crear entradas en secciones vacías */}
      <div class="rounded-2xl border border-dashed border-slate-800 bg-surface-950/70 p-5">
        <p class="font-mono text-xs uppercase text-slate-400">Crear nueva entrada directamente en:</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {SECTION_KEYS.map((sec) => (
            <a
              href={`/admin/new?section=${sec}`}
              class="rounded-xl border border-slate-700 bg-slate-900 px-3.5 py-2 font-mono text-xs text-slate-200 transition hover:border-emerald-400 hover:text-emerald-300"
            >
              + {SECTION_META[sec].shortTitle}
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>

  <script>
    // Cambiar entre Vista Editor y Vista Visitante
    document.querySelectorAll('[data-admin-mode]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const mode = btn.getAttribute('data-admin-mode');
        const res = await fetch('/api/auth/view-mode', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mode }),
        });
        if (res.ok) {
          window.location.href = mode === 'visitor' ? '/' : '/admin';
        }
      });
    });

    // Subir CV
    const cvForm = document.getElementById('cv-upload-form') as HTMLFormElement | null;
    cvForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(cvForm);
      const res = await fetch('/api/profile/cv', { method: 'POST', body: fd });
      const data = await res.json();
      if (res.ok && data.ok) {
        (window as any).showEblToast?.('CV oficial cargado con éxito.');
        setTimeout(() => window.location.reload(), 400);
      } else {
        (window as any).showEblToast?.(data.error || 'Error al subir CV', 'error');
      }
    });

    document.getElementById('btn-delete-cv')?.addEventListener('click', async () => {
      if (!confirm('¿Quitar el archivo PDF del CV actual?')) return;
      const res = await fetch('/api/profile/cv', { method: 'DELETE' });
      if (res.ok) window.location.reload();
    });

    // Guardar Perfil Rápido
    const profileForm = document.getElementById('profile-quick-form') as HTMLFormElement | null;
    profileForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(profileForm);
      const res = await fetch('/api/profile', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fullName: fd.get('fullName'),
          currentSemester: fd.get('currentSemester'),
          headline: fd.get('headline'),
          githubUrl: fd.get('githubUrl'),
          linkedinUrl: fd.get('linkedinUrl'),
          bio: fd.get('bio'),
        }),
      });
      if (res.ok) {
        (window as any).showEblToast?.('Perfil actualizado correctamente.');
      }
    });

    // Filtro por pestañas de sección
    document.querySelectorAll('.ebl-sec-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        const sec = tab.getAttribute('data-sec-filter');
        document.querySelectorAll('.ebl-sec-tab').forEach((t) => {
          t.classList.remove('bg-cyan-500', 'text-slate-950', 'font-bold');
          t.classList.add('bg-slate-900', 'text-slate-300', 'border', 'border-slate-800');
        });
        tab.classList.add('bg-cyan-500', 'text-slate-950', 'font-bold');
        tab.classList.remove('bg-slate-900', 'text-slate-300');

        document.querySelectorAll('[data-entry-row]').forEach((row) => {
          const rowSec = row.getAttribute('data-entry-row');
          (row as HTMLElement).style.display = sec === 'all' || rowSec === sec ? '' : 'none';
        });
      });
    });

    // Eliminar entrada
    document.querySelectorAll('.ebl-delete-entry').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const section = btn.getAttribute('data-section');
        const slug = btn.getAttribute('data-slug');
        const title = btn.getAttribute('data-title');
        if (!confirm(`¿Seguro que deseas eliminar "${title}" y sus archivos asociados?`)) return;

        const res = await fetch(`/api/entries/${section}/${slug}`, { method: 'DELETE' });
        if (res.ok) {
          (window as any).showEblToast?.('Entrada eliminada.');
          setTimeout(() => window.location.reload(), 350);
        }
      });
    });
  </script>
</BaseLayout>
