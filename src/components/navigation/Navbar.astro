---
import { SECTION_META, SECTION_KEYS } from '../../server/schemas';
import type { ViewerContext } from '../../server/auth';

interface Props {
  viewer: ViewerContext;
  currentPath: string;
}

const { viewer, currentPath } = Astro.props;

const primaryNav = SECTION_KEYS.map((key) => SECTION_META[key]);
---

<header class="border-b border-slate-800/80 bg-surface-950/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
    <a href="/" class="group flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg border border-cyan-500/40 bg-cyan-500/10 font-mono text-xs font-bold tracking-tighter text-cyan-300 transition group-hover:border-cyan-400 group-hover:bg-cyan-500/20">
        EBL
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-sm font-semibold tracking-tight text-white">Emmanuel Baltazar</span>
          <span class="hidden rounded border border-slate-700 bg-slate-900 px-1.5 py-0.5 font-mono text-[10px] text-emerald-400 sm:inline">
            UMAD · 9.6
          </span>
        </div>
        <p class="font-mono text-[11px] text-slate-400">Ingeniería de Software · Portafolio de Evidencias</p>
      </div>
    </a>

    <!-- Navegación Desktop -->
    <nav class="hidden items-center gap-1 xl:flex" aria-label="Secciones del portafolio">
      <a
        href="/"
        class:list={[
          'rounded-md px-2.5 py-1.5 text-xs font-medium transition',
          currentPath === '/'
            ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/30'
            : 'text-slate-300 hover:bg-slate-800/70 hover:text-white',
        ]}
      >
        Visión General
      </a>
      {primaryNav.map((sec) => {
        const isActive = currentPath === sec.route || currentPath.startsWith(`${sec.route}/`);
        return (
          <a
            href={sec.route}
            class:list={[
              'rounded-md px-2.5 py-1.5 text-xs font-medium transition',
              isActive
                ? 'bg-cyan-500/15 text-cyan-300 border border-cyan-500/30'
                : 'text-slate-300 hover:bg-slate-800/70 hover:text-white',
            ]}
          >
            {sec.shortTitle}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      {!viewer.isPublicStatic && (
        !viewer.isAuthenticated ? (
          <a
            href="/admin/login"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-700/80 bg-slate-900/80 px-3 py-1.5 font-mono text-xs text-slate-300 transition hover:border-cyan-500/50 hover:text-cyan-300"
            title="Acceder a la Vista Administrador y Editor para subir archivos o editar contenido"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Admin</span>
          </a>
        ) : (
          <a
            href="/admin"
            class="inline-flex items-center gap-1.5 rounded-lg border border-amber-500/40 bg-amber-500/10 px-3 py-1.5 font-mono text-xs text-amber-300 transition hover:bg-amber-500/20"
          >
            <span>Studio</span>
          </a>
        )
      )}

      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex items-center justify-center rounded-lg border border-slate-800 bg-slate-900 p-2 text-slate-300 hover:text-white xl:hidden"
        aria-label="Abrir menú de navegación"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú Mobile / Tablet -->
  <div id="mobile-menu-panel" class="hidden border-t border-slate-800/80 bg-surface-900 px-4 py-3 xl:hidden">
    <div class="grid grid-cols-1 gap-1 sm:grid-cols-2">
      <a
        href="/"
        class="rounded-md px-3 py-2 text-xs font-medium text-slate-200 hover:bg-slate-800"
      >
        00 · Home / Visión General
      </a>
      {primaryNav.map((sec, idx) => (
        <a
          href={sec.route}
          class="rounded-md px-3 py-2 text-xs font-medium text-slate-300 hover:bg-slate-800 hover:text-cyan-300"
        >
          <span class="font-mono text-[11px] text-cyan-400">0{idx + 1} ·</span> {sec.title}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-menu-panel');
  btn?.addEventListener('click', () => {
    panel?.classList.toggle('hidden');
  });
</script>
