---
import {
  EVIDENCE_CATEGORIES,
  EVIDENCE_CATEGORY_LABELS,
  type PortfolioEntry,
  type EvidenceCategory,
} from '../../server/schemas';
import { formatBytes } from '../../server/db';

interface Props {
  entry: PortfolioEntry;
  isEditorView: boolean;
}

const { entry, isEditorView } = Astro.props;

const slotsWithStatus = entry.evidenceSlots.map((slot) => {
  const attached = entry.evidences.find((ev) => ev.slotId === slot.slotId);
  return { slot, attached };
});
---

<section id="evidencias" class="scroll-mt-24 space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-4 border-b border-slate-800 pb-4">
    <div>
      <span class="font-mono text-[11px] uppercase tracking-widest text-cyan-400">
        GALERÍA Y ARTEFACTOS VERIFICABLES // EVIDENCIAS
      </span>
      <h2 class="mt-1 text-2xl font-bold text-white">Evidencias Gráficas, Diagramas y Documentos</h2>
    </div>

    <div class="flex items-center gap-2 font-mono text-xs">
      <span class="rounded-lg border border-slate-800 bg-surface-900 px-3 py-1.5 text-slate-300">
        Archivos publicados: <strong class="text-emerald-400">{entry.evidences.length}</strong>
      </span>
      {isEditorView && entry.evidenceSlots.length > 0 && (
        <span class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-1.5 text-amber-300">
          Espacios sugeridos: {slotsWithStatus.filter((s) => Boolean(s.attached)).length}/{entry.evidenceSlots.length}
        </span>
      )}
    </div>
  </div>

  {/* =====================================================================
      1. RENDERIZADO DE EVIDENCIAS YA SUBIDAS (AMBAS VISTAS)
     ===================================================================== */}
  {entry.evidences.length > 0 ? (
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {entry.evidences.map((ev) => (
        <figure class="group flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-800 bg-surface-900/85 shadow-lg">
          <div>
            {/* Cabecera de categoría */}
            <div class="flex items-center justify-between gap-2 border-b border-slate-800/80 bg-surface-950/70 px-4 py-2.5">
              <span class="font-mono text-[11px] font-medium text-cyan-300">
                {EVIDENCE_CATEGORY_LABELS[ev.category as EvidenceCategory] || ev.category}
              </span>
              <div class="flex items-center gap-2">
                {ev.isCover && (
                  <span class="rounded border border-emerald-500/40 bg-emerald-500/15 px-2 py-0.5 font-mono text-[10px] text-emerald-300">
                    ★ PORTADA BENTO
                  </span>
                )}
                <span class="font-mono text-[10px] text-slate-500">{formatBytes(ev.fileSize)}</span>
              </div>
            </div>

            {/* Visualizador según tipo de medio */}
            {ev.mediaKind === 'image' && (
              <button
                type="button"
                class="ebl-open-lightbox relative block h-64 w-full overflow-hidden bg-slate-950 text-left focus:outline-none"
                data-src={ev.url}
                data-title={ev.title}
                data-alt={ev.alt}
                data-caption={ev.caption}
                data-category={EVIDENCE_CATEGORY_LABELS[ev.category as EvidenceCategory] || ev.category}
              >
                <img
                  src={ev.url}
                  alt={ev.alt}
                  loading="lazy"
                  class="h-full w-full object-contain p-2 transition duration-300 group-hover:scale-[1.02]"
                />
                <span class="absolute bottom-3 right-3 rounded-lg border border-slate-700/90 bg-slate-950/90 px-2.5 py-1 font-mono text-[11px] text-cyan-300 opacity-90 transition group-hover:border-cyan-400">
                  ⤢ Ampliar Lightbox
                </span>
              </button>
            )}

            {ev.mediaKind === 'video' && (
              <div class="bg-slate-950 p-2">
                <video
                  controls
                  preload="metadata"
                  class="h-64 w-full rounded-lg bg-black object-contain"
                >
                  <source src={ev.url} type={ev.mimeType} />
                  Tu navegador no soporta reproducción de video embebido.
                </video>
              </div>
            )}

            {ev.mediaKind === 'pdf' && (
              <div class="flex h-64 flex-col items-center justify-center gap-3 bg-gradient-to-b from-slate-950 to-surface-900 p-6 text-center">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-rose-500/30 bg-rose-500/10 font-mono text-sm font-bold text-rose-300">
                  PDF
                </div>
                <div>
                  <p class="font-semibold text-white">{ev.title}</p>
                  <p class="mt-0.5 font-mono text-xs text-slate-400">{ev.fileName}</p>
                </div>
                <div class="flex flex-wrap justify-center gap-2">
                  <button
                    type="button"
                    class="ebl-open-pdf rounded-lg border border-cyan-500/40 bg-cyan-500/15 px-3.5 py-1.5 font-mono text-xs font-semibold text-cyan-300 transition hover:bg-cyan-500/25"
                    data-pdf-url={ev.url}
                    data-pdf-title={ev.title}
                  >
                    👁 Previsualizar PDF
                  </button>
                  <a
                    href={`${ev.url}?download=1`}
                    class="rounded-lg border border-slate-700 bg-slate-800 px-3.5 py-1.5 font-mono text-xs text-slate-200 transition hover:border-slate-500"
                  >
                    ↓ Descargar
                  </a>
                </div>
              </div>
            )}

            {ev.mediaKind === 'document' && (
              <div class="flex h-56 flex-col items-center justify-center gap-3 bg-slate-950/90 p-6 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-indigo-500/30 bg-indigo-500/10 font-mono text-xs font-bold uppercase text-indigo-300">
                  FILE
                </div>
                <div>
                  <p class="font-semibold text-white">{ev.title}</p>
                  <p class="mt-0.5 font-mono text-xs text-slate-400">{ev.fileName}</p>
                </div>
                <a
                  href={`${ev.url}?download=1`}
                  class="rounded-lg border border-indigo-500/40 bg-indigo-500/15 px-4 py-1.5 font-mono text-xs font-semibold text-indigo-300 transition hover:bg-indigo-500/25"
                >
                  ↓ Descargar Entregable ({formatBytes(ev.fileSize)})
                </a>
              </div>
            )}
          </div>

          {/* Pie de foto técnico obligatorio */}
          <figcaption class="border-t border-slate-800/80 p-4">
            <h3 class="text-sm font-semibold text-white">{ev.title}</h3>
            <p class="mt-1 text-xs leading-relaxed text-slate-300">{ev.caption}</p>
            <p class="mt-2 font-mono text-[11px] text-slate-500">
              <span class="text-slate-400">ALT:</span> {ev.alt}
            </p>

            {/* Controles exclusivos de Vista Administrador / Editor */}
            {isEditorView && (
              <div class="mt-3 border-t border-slate-800 pt-3">
                <div class="flex flex-wrap items-center gap-2">
                  {ev.mediaKind === 'image' && !ev.isCover && (
                    <button
                      type="button"
                      class="ebl-make-cover rounded-md border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1 font-mono text-[11px] text-emerald-300 hover:bg-emerald-500/20"
                      data-ev-id={ev.id}
                      data-section={entry.section}
                      data-slug={entry.slug}
                    >
                      ★ Definir como Portada
                    </button>
                  )}
                  <button
                    type="button"
                    class="ebl-toggle-edit-ev rounded-md border border-slate-700 bg-slate-800 px-2.5 py-1 font-mono text-[11px] text-slate-200 hover:border-cyan-500/40"
                    data-target={`edit-ev-${ev.id}`}
                  >
                    ✎ Editar Alt / Pie de foto
                  </button>
                  <button
                    type="button"
                    class="ebl-delete-ev rounded-md border border-rose-500/40 bg-rose-500/10 px-2.5 py-1 font-mono text-[11px] text-rose-300 hover:bg-rose-500/20"
                    data-ev-id={ev.id}
                    data-section={entry.section}
                    data-slug={entry.slug}
                  >
                    🗑 Eliminar
                  </button>
                </div>

                {/* Formulario inline de edición de metadatos */}
                <form
                  id={`edit-ev-${ev.id}`}
                  class="ebl-edit-ev-form mt-3 hidden space-y-2.5 rounded-xl border border-slate-700 bg-slate-950 p-3"
                  data-ev-id={ev.id}
                  data-section={entry.section}
                  data-slug={entry.slug}
                >
                  <div>
                    <label class="block font-mono text-[10px] uppercase text-slate-400">Título de evidencia</label>
                    <input
                      type="text"
                      name="title"
                      value={ev.title}
                      required
                      class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white"
                    />
                  </div>
                  <div>
                    <label class="block font-mono text-[10px] uppercase text-slate-400">Texto Alternativo Técnico (alt)</label>
                    <input
                      type="text"
                      name="alt"
                      value={ev.alt}
                      required
                      minlength="5"
                      class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white"
                    />
                  </div>
                  <div>
                    <label class="block font-mono text-[10px] uppercase text-slate-400">Pie de foto contextual (caption)</label>
                    <textarea
                      name="caption"
                      rows="2"
                      required
                      minlength="5"
                      class="mt-1 w-full rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white"
                    >{ev.caption}</textarea>
                  </div>
                  <div class="flex items-center justify-between gap-2">
                    <select
                      name="category"
                      class="rounded-lg border border-slate-700 bg-slate-900 px-2.5 py-1.5 font-mono text-xs text-white"
                    >
                      {EVIDENCE_CATEGORIES.map((cat) => (
                        <option value={cat} selected={cat === ev.category}>
                          {EVIDENCE_CATEGORY_LABELS[cat]}
                        </option>
                      ))}
                    </select>
                    <button
                      type="submit"
                      class="rounded-lg bg-cyan-500 px-3 py-1.5 font-mono text-xs font-semibold text-slate-950 hover:bg-cyan-400"
                    >
                      Guardar cambios
                    </button>
                  </div>
                </form>
              </div>
            )}
          </figcaption>
        </figure>
      ))}
    </div>
  ) : (
    !isEditorView && (
      <div class="rounded-2xl border border-dashed border-slate-800 bg-surface-900/50 p-8 text-center">
        <p class="font-mono text-xs uppercase tracking-wider text-slate-400">
          ARCHIVOS MULTIMEDIA PENDIENTES DE PUBLICACIÓN
        </p>
        <p class="mt-2 text-sm text-slate-400">
          El desglose arquitectónico y métricas están verificados. Las capturas, diagramas y documentos adjuntos se mostrarán automáticamente en esta galería al ser publicados.
        </p>
      </div>
    )
  )}

  {/* =====================================================================
      2. ESPACIOS PREPARADOS DE CARGA DE ARCHIVOS (SOLO VISTA ADMIN / EDITOR)
     ===================================================================== */}
  {isEditorView && (
    <div class="mt-8 space-y-6 rounded-2xl border border-amber-500/30 bg-amber-950/[0.08] p-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <span class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-amber-300">
            <span>↑ GESTOR DE ARCHIVOS Y EVIDENCIAS (SOLO VISIBLE EN MODO ADMIN/EDITOR)</span>
          </span>
          <p class="mt-1 text-xs text-slate-300">
            Sube tus propios diagramas, capturas, videos (<code class="text-cyan-300">.mp4</code>), documentos (<code class="text-cyan-300">.pdf</code>) o scripts en cada espacio. Al subirlos se guardan en disco y se renderizan automáticamente tanto aquí como en la <strong>Vista Visitante</strong>.
          </p>
        </div>
      </div>

      {/* Tarjetas de Espacios Sugeridos (Slots) */}
      {slotsWithStatus.length > 0 && (
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          {slotsWithStatus.map(({ slot, attached }) => (
            <div
              class:list={[
                'rounded-xl border p-4 transition',
                attached
                  ? 'border-emerald-500/40 bg-emerald-950/10'
                  : 'border-dashed border-slate-700 bg-surface-950/90 hover:border-cyan-500/50',
              ]}
            >
              <div class="flex items-start justify-between gap-2">
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <span
                      class:list={[
                        'rounded px-2 py-0.5 font-mono text-[10px] font-bold',
                        attached
                          ? 'bg-emerald-500/20 text-emerald-300'
                          : 'bg-amber-500/20 text-amber-300',
                      ]}
                    >
                      {attached ? '✓ ARCHIVO CARGADO (REEMPLAZABLE)' : '⏳ ESPACIO LISTO PARA SUBIR'}
                    </span>
                    <span class="font-mono text-[10px] text-slate-400">
                      {EVIDENCE_CATEGORY_LABELS[slot.category]} · {slot.expectedType.toUpperCase()}
                    </span>
                  </div>
                  <h4 class="mt-2 text-sm font-semibold text-white">{slot.label}</h4>
                </div>

                <button
                  type="button"
                  class="ebl-remove-slot font-mono text-[11px] text-slate-500 hover:text-rose-400"
                  data-section={entry.section}
                  data-slug={entry.slug}
                  data-slot-id={slot.slotId}
                  title="Quitar este espacio sugerido"
                >
                  ✕
                </button>
              </div>

              <form class="ebl-upload-form mt-3 space-y-2.5">
                <input type="hidden" name="section" value={entry.section} />
                <input type="hidden" name="slug" value={entry.slug} />
                <input type="hidden" name="slotId" value={slot.slotId} />
                <input type="hidden" name="title" value={slot.label} />
                <input type="hidden" name="category" value={slot.category} />

                <div>
                  <label class="block font-mono text-[10px] text-slate-400">
                    Seleccionar archivo ({slot.expectedType === 'image' ? 'PNG, JPG, WEBP, SVG' : slot.expectedType === 'pdf' ? 'PDF' : slot.expectedType === 'video' ? 'MP4, WEBM' : 'Imagen, PDF, Video o Documento'})
                  </label>
                  <input
                    type="file"
                    name="file"
                    required
                    class="mt-1 block w-full cursor-pointer rounded-lg border border-slate-700 bg-slate-900 text-xs text-slate-300 file:mr-3 file:cursor-pointer file:rounded-md file:border-0 file:bg-cyan-500/20 file:px-3 file:py-1.5 file:font-mono file:text-xs file:font-semibold file:text-cyan-300 hover:file:bg-cyan-500/30"
                  />
                </div>

                <div class="grid grid-cols-1 gap-2">
                  <div>
                    <label class="block font-mono text-[10px] text-slate-400">Texto Alternativo Técnico (alt)</label>
                    <input
                      type="text"
                      name="alt"
                      required
                      minlength="5"
                      value={attached?.alt || slot.suggestedAlt || `${slot.label} — ${entry.title}`}
                      class="mt-0.5 w-full rounded-lg border border-slate-800 bg-slate-900 px-2.5 py-1.5 text-xs text-slate-200 focus:border-cyan-500 focus:outline-none"
                    />
                  </div>
                  <div>
                    <label class="block font-mono text-[10px] text-slate-400">Pie de foto descriptivo (caption)</label>
                    <input
                      type="text"
                      name="caption"
                      required
                      minlength="5"
                      value={attached?.caption || slot.suggestedCaption || `Evidencia verificada: ${slot.label}.`}
                      class="mt-0.5 w-full rounded-lg border border-slate-800 bg-slate-900 px-2.5 py-1.5 text-xs text-slate-200 focus:border-cyan-500 focus:outline-none"
                    />
                  </div>
                </div>

                <div class="flex items-center justify-between pt-1">
                  <label class="inline-flex items-center gap-1.5 font-mono text-[11px] text-slate-400">
                    <input type="checkbox" name="isCover" class="rounded border-slate-700 bg-slate-900 text-cyan-500" />
                    <span>Usar como portada (si es imagen)</span>
                  </label>
                  <button
                    type="submit"
                    class="rounded-lg bg-cyan-500 px-3.5 py-1.5 font-mono text-xs font-semibold text-slate-950 transition hover:bg-cyan-400"
                  >
                    {attached ? '↻ Reemplazar Archivo' : '↑ Subir y Mostrar'}
                  </button>
                </div>
              </form>
            </div>
          ))}
        </div>
      )}

      {/* Subida Libre Adicional + Crear Nuevo Slot */}
      <div class="grid grid-cols-1 gap-4 border-t border-slate-800/80 pt-5 lg:grid-cols-3">
        <form class="ebl-upload-form space-y-3 rounded-xl border border-cyan-500/30 bg-surface-950 p-4 lg:col-span-2">
          <div class="flex items-center justify-between">
            <h4 class="font-mono text-xs font-bold uppercase text-cyan-300">
              + Subir Evidencia o Archivo Adicional Libre
            </h4>
            <span class="font-mono text-[10px] text-slate-400">Imágenes · PDF · MP4 · SQL · ZIP · DOCX</span>
          </div>

          <input type="hidden" name="section" value={entry.section} />
          <input type="hidden" name="slug" value={entry.slug} />

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <label class="block font-mono text-[10px] text-slate-400">Título de la evidencia</label>
              <input
                type="text"
                name="title"
                required
                placeholder="Ej. Captura Módulo de Cotizaciones / Diagrama Secuencia"
                class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 text-xs text-white"
              />
            </div>
            <div>
              <label class="block font-mono text-[10px] text-slate-400">Categoría técnica</label>
              <select
                name="category"
                class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 font-mono text-xs text-white"
              >
                {EVIDENCE_CATEGORIES.map((cat) => (
                  <option value={cat}>{EVIDENCE_CATEGORY_LABELS[cat]}</option>
                ))}
              </select>
            </div>
          </div>

          <div>
            <label class="block font-mono text-[10px] text-slate-400">Archivo local</label>
            <input
              type="file"
              name="file"
              required
              class="mt-1 block w-full cursor-pointer rounded-lg border border-slate-800 bg-slate-900 text-xs text-slate-300 file:mr-3 file:rounded-md file:border-0 file:bg-emerald-500/20 file:px-3 file:py-1.5 file:font-mono file:text-xs file:font-semibold file:text-emerald-300"
            />
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <label class="block font-mono text-[10px] text-slate-400">Texto Alternativo Técnico (alt)</label>
              <input
                type="text"
                name="alt"
                required
                minlength="5"
                placeholder="Descripción técnica exacta de la imagen o documento..."
                class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 text-xs text-white"
              />
            </div>
            <div>
              <label class="block font-mono text-[10px] text-slate-400">Pie de foto (caption)</label>
              <input
                type="text"
                name="caption"
                required
                minlength="5"
                placeholder="Qué demuestra o valida esta evidencia..."
                class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 text-xs text-white"
              />
            </div>
          </div>

          <div class="flex items-center justify-between pt-1">
            <label class="inline-flex items-center gap-1.5 font-mono text-xs text-slate-400">
              <input type="checkbox" name="isCover" class="rounded border-slate-700 bg-slate-900 text-cyan-500" />
              <span>Definir como portada de la tarjeta Bento</span>
            </label>
            <button
              type="submit"
              class="rounded-lg bg-emerald-500 px-4 py-2 font-mono text-xs font-bold text-slate-950 transition hover:bg-emerald-400"
            >
              ↑ Subir Archivo Ahora
            </button>
          </div>
        </form>

        {/* Añadir nuevo Slot vacío para dejar el espacio reservado */}
        <form id="ebl-create-slot-form" class="space-y-3 rounded-xl border border-slate-800 bg-surface-950 p-4">
          <h4 class="font-mono text-xs font-bold uppercase text-amber-300">
            + Reservar Nuevo Espacio (Slot)
          </h4>
          <p class="text-[11px] text-slate-400">
            ¿Quieres dejar un espacio etiquetado listo para subir un archivo más adelante? Créalo aquí:
          </p>
          <input type="hidden" name="section" value={entry.section} />
          <input type="hidden" name="slug" value={entry.slug} />

          <div>
            <label class="block font-mono text-[10px] text-slate-400">Nombre del espacio</label>
            <input
              type="text"
              name="label"
              required
              placeholder="Ej. Constancia Jurado / Video Demo"
              class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-900 px-2.5 py-1.5 text-xs text-white"
            />
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block font-mono text-[10px] text-slate-400">Tipo esperado</label>
              <select
                name="expectedType"
                class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-900 px-2 py-1.5 font-mono text-xs text-white"
              >
                <option value="image">Imagen</option>
                <option value="pdf">PDF</option>
                <option value="video">Video</option>
                <option value="any">Cualquiera</option>
              </select>
            </div>
            <div>
              <label class="block font-mono text-[10px] text-slate-400">Categoría</label>
              <select
                name="category"
                class="mt-1 w-full rounded-lg border border-slate-800 bg-slate-900 px-2 py-1.5 font-mono text-xs text-white"
              >
                {EVIDENCE_CATEGORIES.map((cat) => (
                  <option value={cat}>{EVIDENCE_CATEGORY_LABELS[cat]}</option>
                ))}
              </select>
            </div>
          </div>

          <button
            type="submit"
            class="w-full rounded-lg border border-amber-500/40 bg-amber-500/15 px-3 py-2 font-mono text-xs font-semibold text-amber-300 transition hover:bg-amber-500/25"
          >
            + Crear Espacio de Carga
          </button>
        </form>
      </div>
    </div>
  )}
</section>

{/* =========================================================================
    MODAL LIGHTBOX PARA IMÁGENES / DIAGRAMAS
   ========================================================================= */}
<div
  id="ebl-lightbox-modal"
  class="fixed inset-0 z-[90] hidden items-center justify-center bg-slate-950/95 p-4 backdrop-blur-md"
  role="dialog"
  aria-modal="true"
>
  <div class="relative flex max-h-[92vh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl border border-slate-700 bg-surface-900 shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-800 px-5 py-3">
      <div>
        <span id="ebl-lb-category" class="font-mono text-[11px] text-cyan-400"></span>
        <h3 id="ebl-lb-title" class="text-sm font-bold text-white"></h3>
      </div>
      <div class="flex items-center gap-2">
        <a
          id="ebl-lb-download"
          href="#"
          target="_blank"
          class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-1 font-mono text-xs text-slate-200 hover:border-cyan-400"
        >
          Abrir original ↗
        </a>
        <button
          type="button"
          id="ebl-lb-close"
          class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-1 font-mono text-xs text-white hover:bg-rose-500/20"
        >
          ✕ Cerrar
        </button>
      </div>
    </div>

    <div class="flex-1 overflow-auto bg-slate-950 p-4 text-center">
      <img id="ebl-lb-img" src="" alt="" class="mx-auto max-h-[68vh] w-auto object-contain" />
    </div>

    <div class="border-t border-slate-800 bg-surface-900 px-5 py-3.5">
      <p id="ebl-lb-caption" class="text-xs leading-relaxed text-slate-200"></p>
      <p id="ebl-lb-alt" class="mt-1 font-mono text-[11px] text-slate-400"></p>
    </div>
  </div>
</div>

{/* =========================================================================
    MODAL VISOR PDF EMBEBIDO
   ========================================================================= */}
<div
  id="ebl-pdf-modal"
  class="fixed inset-0 z-[90] hidden items-center justify-center bg-slate-950/95 p-4 backdrop-blur-md"
  role="dialog"
  aria-modal="true"
>
  <div class="flex h-[90vh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl border border-slate-700 bg-surface-900 shadow-2xl">
    <div class="flex items-center justify-between border-b border-slate-800 px-5 py-3">
      <h3 id="ebl-pdf-title" class="text-sm font-bold text-white">Documento PDF</h3>
      <div class="flex items-center gap-2">
        <a
          id="ebl-pdf-external"
          href="#"
          target="_blank"
          class="rounded-lg border border-cyan-500/40 bg-cyan-500/10 px-3 py-1 font-mono text-xs text-cyan-300"
        >
          Abrir en pestaña ↗
        </a>
        <button
          type="button"
          id="ebl-pdf-close"
          class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-1 font-mono text-xs text-white"
        >
          ✕ Cerrar
        </button>
      </div>
    </div>
    <iframe id="ebl-pdf-frame" src="" class="h-full w-full flex-1 bg-slate-950" title="Visor de PDF"></iframe>
  </div>
</div>

<script>
  // Lightbox de Imágenes
  const lbModal = document.getElementById('ebl-lightbox-modal');
  const lbImg = document.getElementById('ebl-lb-img') as HTMLImageElement | null;
  const lbTitle = document.getElementById('ebl-lb-title');
  const lbCat = document.getElementById('ebl-lb-category');
  const lbCaption = document.getElementById('ebl-lb-caption');
  const lbAlt = document.getElementById('ebl-lb-alt');
  const lbDownload = document.getElementById('ebl-lb-download') as HTMLAnchorElement | null;

  document.querySelectorAll('.ebl-open-lightbox').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-src') || '';
      const title = btn.getAttribute('data-title') || '';
      const alt = btn.getAttribute('data-alt') || '';
      const caption = btn.getAttribute('data-caption') || '';
      const category = btn.getAttribute('data-category') || '';

      if (lbImg) {
        lbImg.src = src;
        lbImg.alt = alt;
      }
      if (lbTitle) lbTitle.textContent = title;
      if (lbCat) lbCat.textContent = category;
      if (lbCaption) lbCaption.textContent = caption;
      if (lbAlt) lbAlt.textContent = `ALT TÉCNICO: ${alt}`;
      if (lbDownload) lbDownload.href = src;

      lbModal?.classList.remove('hidden');
      lbModal?.classList.add('flex');
    });
  });

  function closeLightbox() {
    lbModal?.classList.add('hidden');
    lbModal?.classList.remove('flex');
    if (lbImg) lbImg.src = '';
  }

  document.getElementById('ebl-lb-close')?.addEventListener('click', closeLightbox);
  lbModal?.addEventListener('click', (e) => {
    if (e.target === lbModal) closeLightbox();
  });

  // Visor PDF Embebido
  const pdfModal = document.getElementById('ebl-pdf-modal');
  const pdfFrame = document.getElementById('ebl-pdf-frame') as HTMLIFrameElement | null;
  const pdfTitle = document.getElementById('ebl-pdf-title');
  const pdfExternal = document.getElementById('ebl-pdf-external') as HTMLAnchorElement | null;

  document.querySelectorAll('.ebl-open-pdf').forEach((btn) => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-pdf-url') || '';
      const title = btn.getAttribute('data-pdf-title') || 'Documento PDF';
      if (pdfFrame) pdfFrame.src = url;
      if (pdfTitle) pdfTitle.textContent = title;
      if (pdfExternal) pdfExternal.href = url;
      pdfModal?.classList.remove('hidden');
      pdfModal?.classList.add('flex');
    });
  });

  function closePdfModal() {
    pdfModal?.classList.add('hidden');
    pdfModal?.classList.remove('flex');
    if (pdfFrame) pdfFrame.src = '';
  }

  document.getElementById('ebl-pdf-close')?.addEventListener('click', closePdfModal);
  pdfModal?.addEventListener('click', (e) => {
    if (e.target === pdfModal) closePdfModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeLightbox();
      closePdfModal();
    }
  });

  // Subida de archivos (Slots + Libre)
  document.querySelectorAll('.ebl-upload-form').forEach((formEl) => {
    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = formEl as HTMLFormElement;
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const prevText = submitBtn?.textContent || 'Subir';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Subiendo archivo...';
      }

      try {
        const fd = new FormData(form);
        const res = await fetch('/api/evidences/upload', {
          method: 'POST',
          body: fd,
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          throw new Error(data.error || 'Error al subir archivo');
        }
        (window as any).showEblToast?.('Archivo subido y renderizado correctamente.');
        setTimeout(() => window.location.reload(), 450);
      } catch (err: any) {
        (window as any).showEblToast?.(err.message || 'No se pudo subir el archivo', 'error');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = prevText;
        }
      }
    });
  });

  // Toggle edición metadatos de evidencia
  document.querySelectorAll('.ebl-toggle-edit-ev').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;
      document.getElementById(targetId)?.classList.toggle('hidden');
    });
  });

  // Guardar edición metadatos de evidencia
  document.querySelectorAll('.ebl-edit-ev-form').forEach((formEl) => {
    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = formEl as HTMLFormElement;
      const evId = form.getAttribute('data-ev-id');
      const section = form.getAttribute('data-section');
      const slug = form.getAttribute('data-slug');
      const fd = new FormData(form);

      const res = await fetch(`/api/evidences/${evId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          section,
          slug,
          title: fd.get('title'),
          alt: fd.get('alt'),
          caption: fd.get('caption'),
          category: fd.get('category'),
        }),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        (window as any).showEblToast?.('Metadatos actualizados.');
        setTimeout(() => window.location.reload(), 350);
      } else {
        (window as any).showEblToast?.(data.error || 'Error al guardar', 'error');
      }
    });
  });

  // Marcar como portada
  document.querySelectorAll('.ebl-make-cover').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const evId = btn.getAttribute('data-ev-id');
      const section = btn.getAttribute('data-section');
      const slug = btn.getAttribute('data-slug');
      const res = await fetch(`/api/evidences/${evId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ section, slug, isCover: true }),
      });
      if (res.ok) {
        (window as any).showEblToast?.('Portada actualizada.');
        setTimeout(() => window.location.reload(), 350);
      }
    });
  });

  // Eliminar evidencia subida
  document.querySelectorAll('.ebl-delete-ev').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('¿Eliminar este archivo de evidencia? El espacio volverá a quedar disponible.')) return;
      const evId = btn.getAttribute('data-ev-id');
      const section = btn.getAttribute('data-section');
      const slug = btn.getAttribute('data-slug');
      const res = await fetch(`/api/evidences/${evId}?section=${section}&slug=${slug}`, {
        method: 'DELETE',
      });
      if (res.ok) {
        (window as any).showEblToast?.('Archivo eliminado.');
        setTimeout(() => window.location.reload(), 350);
      }
    });
  });

  // Crear nuevo slot
  const slotForm = document.getElementById('ebl-create-slot-form') as HTMLFormElement | null;
  slotForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(slotForm);
    const res = await fetch('/api/slots', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        section: fd.get('section'),
        slug: fd.get('slug'),
        label: fd.get('label'),
        expectedType: fd.get('expectedType'),
        category: fd.get('category'),
      }),
    });
    const data = await res.json();
    if (res.ok && data.ok) {
      (window as any).showEblToast?.('Nuevo espacio de carga creado.');
      setTimeout(() => window.location.reload(), 350);
    } else {
      (window as any).showEblToast?.(data.error || 'Error al crear espacio', 'error');
    }
  });

  // Eliminar slot
  document.querySelectorAll('.ebl-remove-slot').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('¿Quitar este espacio sugerido de la lista?')) return;
      const section = btn.getAttribute('data-section');
      const slug = btn.getAttribute('data-slug');
      const slotId = btn.getAttribute('data-slot-id');
      const res = await fetch('/api/slots', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ section, slug, slotId }),
      });
      if (res.ok) {
        window.location.reload();
      }
    });
  });
</script>
